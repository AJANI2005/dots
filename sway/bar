set $BG      #111111
set $FG      #CDD6F4
set $ACCENT  #89B4FA
set $SURFACE #1E1E2E
set $MUTED   #6C7086
set $SUCCESS #A6E3A1
set $INFO    #89DCEB
set $WARNING #F9E2AF
set $DANGER  #F38BA8

bar {
    position top

    status_command ~/.config/sway/scripts/bar.sh
    pango_markup yes
    font pango:0xProto Nerd Font 10

    colors {
        background          $BG
        statusline          $FG

        focused_workspace   $ACCENT  $ACCENT  $BG
        active_workspace    $SURFACE $SURFACE $FG
        inactive_workspace  $BG      $BG      $MUTED
        urgent_workspace    $DANGER  $DANGER  $BG
    }
}
