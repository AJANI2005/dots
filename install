#!/usr/bin/env bash
set -euo pipefail

DOTS="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
CONFIG="$HOME/.config"

mkdir -p "$CONFIG"

if [ "$#" -eq 0 ]; then
    echo "Usage: $0 <item> [item ...]" >&2
    exit 1
fi

for name in "$@"; do
    item="$DOTS/$name"

    if [ ! -e "$item" ] && [ ! -L "$item" ]; then
        echo "NOT FOUND: $item" >&2
        continue
    fi

    target="$CONFIG/$name"

    if [ -e "$target" ] || [ -L "$target" ]; then
        echo "SKIPPED: $target already exists"
        continue
    fi

    ln -s "$item" "$target"
    echo "LINKED: $target -> $item"
done
